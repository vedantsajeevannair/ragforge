# Copy to .env and adjust. Every setting is optional.

# Answer generation: extractive (offline, default) | anthropic | openai | ollama
RAGFORGE_LLM_PROVIDER=extractive
RAGFORGE_LLM_MODEL=
RAGFORGE_LLM_API_KEY=
# For openai/ollama, e.g. http://localhost:11434/v1
RAGFORGE_LLM_BASE_URL=

# Embeddings: hashing (offline, default) | http (any OpenAI-compatible /embeddings)
RAGFORGE_EMBEDDING_PROVIDER=hashing
RAGFORGE_EMBEDDING_DIM=512
RAGFORGE_EMBEDDING_MODEL=
RAGFORGE_EMBEDDING_BASE_URL=
RAGFORGE_EMBEDDING_API_KEY=

RAGFORGE_CHUNK_SIZE=800
RAGFORGE_CHUNK_OVERLAP=120

# Leave empty to auto-generate a 64-character secret in the data folder.
RAGFORGE_JWT_SECRET=
RAGFORGE_JSON_LOGS=false
